FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
COPY --from=ghcr.io/astral-sh/uv:0.13.9@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d /uv /usr/local/bin/uv
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --link-mode copy "apache-airflow==3.1.8" \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-3.1.8/constraints-3.12.txt" \
    && uv pip install --system --no-deps --link-mode copy psycopg==3.3.2 psycopg-binary==3.3.2 numpy==2.5.5 \
    && uv pip check --system
RUN useradd --create-home --uid 50000 airflow \
    && install -d -o airflow -g airflow /opt/airflow

WORKDIR /agelens
COPY --chown=airflow:airflow services/orchestration ./services/orchestration
COPY --chown=airflow:airflow airflow_dags ./airflow_dags
ENV PYTHONPATH=/agelens AIRFLOW_HOME=/opt/airflow PYTHONUNBUFFERED=1
USER airflow
ENTRYPOINT ["airflow"]
